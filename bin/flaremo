#!/usr/bin/env node

/**
 * FlareMo Memory Ledger CLI (v2)
 *
 * Lightweight, zero-daemon command-line interface for agents & humans.
 * Exit code contract:
 *   0: Success
 *   1: Command or validation error
 *   3: Memory service unreachable (offline fallback triggered)
 */

import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";
import { createHash } from "node:crypto";

const FLAREMO_URL =
  process.env.FLAREMO_URL ||
  process.env.FLAREMO_DEV_URL ||
  "http://127.0.0.1:8787";

const FLAREMO_PAT = process.env.FLAREMO_PAT || "";
const CACHE_DIR = join(homedir(), ".flaremo", "cache");

function getAnchor() {
  const cwd = process.cwd();
  return createHash("sha256").update(cwd).digest("hex").slice(0, 16);
}

function getCachePath(anchor = getAnchor()) {
  if (!existsSync(CACHE_DIR)) {
    mkdirSync(CACHE_DIR, { recursive: true });
  }
  return join(CACHE_DIR, `${anchor}.md`);
}

async function callMcp(toolName, args, command = "") {
  const url = `${FLAREMO_URL.replace(/\/+$/, "")}/memory/mcp`;
  const headers = {
    "Content-Type": "application/json",
  };
  if (FLAREMO_PAT) {
    headers["Authorization"] = `Bearer ${FLAREMO_PAT}`;
  }

  const payload = {
    jsonrpc: "2.0",
    id: 1,
    method: "tools/call",
    params: {
      name: toolName,
      arguments: args,
    },
  };

  let res;
  try {
    res = await fetch(url, {
      method: "POST",
      headers,
      body: JSON.stringify(payload),
    });
  } catch (error) {
    handleUnreachable(error, command);
    return undefined;
  }

  if (res.status === 401 || res.status === 403) {
    console.error(
      `❌ 鉴权失败 (${res.status})：检查 FLAREMO_PAT 是否已设置且未过期。`,
    );
    process.exit(1);
  }
  if (!res.ok) {
    const text = await res.text();
    console.error(`FlareMo Error (${res.status}): ${text}`);
    process.exit(1);
  }

  const data = await res.json();
  if (data.error) {
    console.error(`MCP Error (${data.error.code}): ${data.error.message}`);
    process.exit(1);
  }
  const structured = data.result?.structuredContent ?? data.result;
  // Tool failures arrive inside a successful JSON-RPC envelope. Without this
  // check a denied write would print "saved" and exit 0.
  if (data.result?.isError || structured?.error) {
    const message = structured?.error?.message ?? "tool call failed";
    console.error(`❌ ${message}`);
    process.exit(1);
  }
  return structured;
}

/**
 * `memory_recall` returns a list, and the MCP envelope normalizes a bare list
 * into `{ result: [...] }` to keep every tool answer an object. Unwrap that
 * shape so callers can treat recall like the array it conceptually is.
 */
function unwrapList(value) {
  if (Array.isArray(value)) return value;
  if (value && Array.isArray(value.result)) return value.result;
  return [];
}

/**
 * Exit codes are part of the agent contract (SKILL.md):
 *   0 — served live from the ledger
 *   0 + stderr `[离线模式]` — served from a local snapshot (the caller may
 *       proceed, but must not claim it consulted the current ledger)
 *   3 — no memory available at all: nothing live, nothing cached
 *   1 — bad arguments, auth failure, or a rejected tool call
 */
function handleUnreachable(error, command = "") {
  const isLensCommand = ["lens", "bootstrap", "status"].includes(command);
  const cachePath = getCachePath();
  if (isLensCommand && existsSync(cachePath)) {
    const cached = readFileSync(cachePath, "utf-8");
    console.warn("⚠️ [离线模式] 记忆服务不可达，已降级使用缓存快照\n");
    console.log(cached);
    process.exit(0);
  }
  console.error("❌ 错误：记忆服务不可达 (Service Unreachable)");
  console.error(
    `无法连接到 ${FLAREMO_URL}${isLensCommand ? "，且无本地缓存快照可用" : ""}。`,
  );
  process.exit(3);
}

function parseCliArgs() {
  const args = process.argv.slice(2);
  const command = args[0];
  const options = {};
  const positional = [];

  for (let i = 1; i < args.length; i++) {
    const arg = args[i];
    if (arg.startsWith("--")) {
      const key = arg.slice(2).replace(/-/g, "_");
      const next = args[i + 1];
      const value = next && !next.startsWith("--") ? (i++, next) : true;
      // Repeatable flags (e.g. `checkpoint --item a --item b`) accumulate into
      // an array instead of silently overwriting earlier values.
      options[key] =
        options[key] === undefined
          ? value
          : Array.isArray(options[key])
            ? [...options[key], value]
            : [options[key], value];
    } else {
      positional.push(arg);
    }
  }

  return { command, positional, options };
}

/** Scalar options: last occurrence wins when a flag is repeated. */
const last = (v) => (Array.isArray(v) ? v[v.length - 1] : v);
/** Repeatable options: every occurrence is kept. */
const all = (v) => (v === undefined ? [] : Array.isArray(v) ? v : [v]);

/** The repo checkout this CLI came from ships the skill source next to it. */
function skillRepoPresent() {
  return existsSync(join(process.cwd(), "skills", "flaremo-memory", "SKILL.md"));
}

async function main() {
  const { command, positional, options } = parseCliArgs();

  if (!command || command === "help" || command === "--help" || command === "-h") {
    printHelp();
    process.exit(0);
  }

  const agent = last(options.agent) || process.env.FLAREMO_AGENT || "cli";
  const projectKey = last(options.project) || last(options.scope) || process.env.FLAREMO_PROJECT || process.cwd();

  switch (command) {
    case "setup": {
      // Self-check installer (§V.5 of the harness adapter spec): verify env,
      // connectivity, auth and skill placement — the "product is one step"
      // contract. Read-only except for the skill copy it offers; never prints
      // the PAT itself.
      console.log("FlareMo 记忆接入自检\n");

      const url = FLAREMO_URL;
      console.log(`1) 实例 URL: ${url} ${url ? "✅" : "❌ 未设置 FLAREMO_URL"}`);

      const pat = process.env.FLAREMO_PAT;
      if (!pat) {
        console.log("2) 凭据: ❌ 未设置 FLAREMO_PAT（在实例 Web → 设置 → 个人访问令牌 创建，填入 ~/.zshrc）");
        process.exit(1);
      }
      console.log("2) 凭据: ✅ FLAREMO_PAT 已设置");

      let health = "";
      try {
        const res = await fetch(`${url.replace(/\/+$/, "")}/healthz`);
        health = res.ok ? "✅ 服务可达" : `⚠️ /healthz 返回 ${res.status}（继续校验鉴权）`;
      } catch {
        try {
          const res = await fetch(`${url.replace(/\/+$/, "")}/`);
          health = res.status < 500 ? "✅ 服务可达" : `❌ 服务异常 (${res.status})`;
        } catch (error) {
          console.log(`3) 连通性: ❌ 无法连接 (${error instanceof Error ? error.message : error})`);
          process.exit(3);
        }
      }
      console.log(`3) 连通性: ${health}`);

      try {
        const res = await fetch(`${url.replace(/\/+$/, "")}/memory/mcp`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${pat}`,
          },
          body: JSON.stringify({
            jsonrpc: "2.0",
            id: 1,
            method: "tools/list",
            params: {},
          }),
        });
        if (res.status === 401 || res.status === 403) {
          console.log("4) 鉴权: ❌ PAT 无效或已过期");
          process.exit(1);
        }
        const data = await res.json();
        const tools = data?.result?.tools;
        console.log(
          `4) 鉴权: ✅ PAT 有效（发现 ${Array.isArray(tools) ? tools.length : "?"} 个记忆工具）`,
        );
      } catch (error) {
        console.log(`4) 鉴权: ❌ 校验失败 (${error instanceof Error ? error.message : error})`);
        process.exit(1);
      }

      const skillDirs = [
        join(homedir(), ".agents", "skills"),
        join(homedir(), ".claude", "skills"),
        join(homedir(), ".codex", "skills"),
      ];
      const skillSource = join(process.cwd(), "skills", "flaremo-memory", "SKILL.md");
      const installed = skillDirs
        .map((dir) => join(dir, "flaremo-memory", "SKILL.md"))
        .filter((p) => existsSync(p));
      console.log(
        `5) Skill: ${installed.length > 0 ? `✅ 已安装 → ${installed[0]}` : skillRepoPresent() ? "⚠️ 未安装（仓库里有，可拷贝到 ~/.agents/skills/flaremo-memory/）" : "ℹ️ 本目录没有仓库 skill 源，跳过"}`,
      );

      console.log("\n全部就绪。四步日常：flaremo lens / remember / recall / checkpoint");
      break;
    }

    case "recall": {
      const query = positional[0];
      if (!query) {
        console.error("用法: flaremo recall <查询词> [--as-of YYYY-MM-DD] [--from-scope <scope>]");
        process.exit(1);
      }

      const results = unwrapList(
        await callMcp(
          "memory_recall",
          {
            query,
            agent,
            project_key: projectKey,
            from_scope: last(options.from_scope),
            fact_key: last(options.key),
            as_of: last(options.as_of),
            include_inferred: Boolean(options.include_inferred),
            limit: options.limit ? Number(last(options.limit)) : 8,
          },
          command,
        ),
      );

      if (results.length === 0) {
        console.log("未找到匹配的记忆。");
        return;
      }

      console.log(`\n🔍 召回结果 (${results.length} 条):\n`);
      for (const item of results) {
        const badge = item.verification === "locked" ? "📌 拍板" : item.verification === "confirmed" ? "✅ 确认" : item.verification === "observed" ? "👀 发现" : "💡 猜想";
        const paths = (item.match_paths || [item.matched_by]).join(",");
        console.log(`[${badge}] [命中: ${paths}] ${item.content}`);
        if (item.fact_key) console.log(`   └─ 事实键: ${item.fact_key}`);
        if (item.evidence && item.evidence.length > 0) {
          console.log(`   └─ 依据: ${item.evidence[0].excerpt || item.evidence[0].source_type}`);
        }
      }
      console.log();
      break;
    }

    case "remember": {
      const content = positional[0];
      if (!content) {
        console.error(
          "用法: flaremo remember <记忆内容> [--key <fact_key>] [--tags <tag1,tag2>] [--scope-type project|global]",
        );
        process.exit(1);
      }

      const tags = all(options.tags)
        .flatMap((v) => String(v).split(","))
        .map((s) => s.trim())
        .filter(Boolean);
      // Agents only ever write 👀 observed / 💡 inferred; promotion to ✅/📌 is a
      // human act. `idempotency_key` makes a retried call return the first row
      // instead of creating a twin.
      const writeKey =
        last(options.idempotency_key) ||
        process.env.FLAREMO_IDEMPOTENCY_KEY ||
        undefined;
      const result = await callMcp(
        "memory_remember",
        {
          content,
          fact_key: last(options.key) || undefined,
          tags,
          type: last(options.type) || "semantic",
          kind: last(options.kind) || "fact",
          scope_type: last(options.scope_type) || (projectKey ? "project" : "global"),
          scope_key: projectKey || undefined,
          verification: "observed",
          source_agent: agent,
          idempotency_key: writeKey,
        },
        command,
      );

      if (result?.duplicate) {
        console.log(`ℹ️ 已存在完全相同的内容 (ID: ${result.memory?.id})`);
      } else if (result?.memory) {
        const v = result.memory.verification;
        const msg =
          v === "inferred"
            ? "💡 已作为提案递交至审核箱 (需人类确认)"
            : "✅ 记忆已保存";
        console.log(`${msg} (ID: ${result.memory.id})`);
      } else {
        console.log("✅ 记忆已保存");
      }
      break;
    }

    case "checkpoint": {
      const summary = positional[0];
      if (!summary) {
        console.error("用法: flaremo checkpoint <战报摘要> [--item <原子结论>]...");
        process.exit(1);
      }

      const items = [];
      const rawItems = all(options.item).filter((v) => typeof v === "string");
      if (rawItems.length > 0) {
        for (const it of rawItems) {
          items.push({ content: it, type: "semantic", kind: "fact", importance: 60 });
        }
      } else {
        items.push({ content: summary, type: "semantic", kind: "fact", importance: 50 });
      }

      const result = await callMcp("memory_checkpoint", {
        agent,
        project_key: projectKey,
        scope_type: "project",
        scope_key: projectKey,
        summary,
        items,
      }, command);

      console.log(`🎯 战报历程已记录 (ID: ${result.episode?.id || "ok"})`);
      console.log(`   衍生原子结论: ${result.items?.length || 0} 条`);
      break;
    }

    case "lens":
    case "bootstrap": {
      // `lens` asks the server for the actual projection — the same bytes an
      // agent would receive — rather than re-rendering a client-side imitation.
      // Re-implementing the format here would drift from compileCoreMemory and
      // make "what does the agent see?" a guess again.
      const compiled = await callMcp(
        "memory_compile",
        {
          agent,
          project_key: projectKey,
          max_chars: options.max_chars ? Number(last(options.max_chars)) : 6000,
        },
        command,
      );

      if (!compiled?.system_prompt_payload) {
        console.log("当前项目无活跃随身锦囊。");
        return;
      }

      console.log(compiled.system_prompt_payload);
      console.log(
        `\n--- 预算: ${compiled.character_count} 字符 / ≈${compiled.estimated_tokens} tokens`,
      );
      if (compiled.pinned_overflow) {
        console.warn(
          "⚠️ 铁律本身已超出预算：本次只带了铁律，其余全部让位。",
        );
      } else if (compiled.has_overflow) {
        console.warn(
          `⚠️ 另有 ${compiled.truncated_items?.length ?? 0} 条因预算被裁。`,
        );
      }

      // Snapshot for the offline fallback (exit code 3 path).
      try {
        writeFileSync(getCachePath(), compiled.system_prompt_payload, "utf-8");
      } catch {}
      break;
    }

    case "status": {
      const result = await callMcp("memory_bootstrap", {
        agent,
        project_key: projectKey,
        max_items: 50,
      }, command);
      const items = result.items || [];
      console.log(`\n📌 活跃便签 (${items.length} 条) - Context: ${projectKey}\n`);
      for (const item of items) {
        const badge =
          item.verification === "locked"
            ? "📌 我拍板的"
            : item.verification === "confirmed"
              ? "✅ 我确认过"
              : item.verification === "observed"
                ? "👀 AI 发现"
                : "💡 AI 猜想";
        console.log(`• [${badge}] ${item.content}`);
      }
      console.log();
      break;
    }

    case "seed": {
      // Cold-start seeding (§VI.2, v2.4): a fresh project has no memories, so
      // scan the local README / AGENTS convention files and apply a handful of
      // candidate notes DIRECTLY as 👀 observed facts — they come from the
      // user's own repo docs, so confidence is high and grading each one is
      // busywork. Delete-on-sight replaces approve-or-reject: anything wrong
      // gets removed in one click from the memory page. Content is
      // deterministic (heading + leading sentence), and each candidate carries
      // an idempotency key derived from file identity so a re-run never
      // spawns duplicates.
      const sourceFiles = ["AGENTS.md", "README.md", "CLAUDE.md"].map((name) =>
        join(process.cwd(), name),
      );
      const candidates = [];
      for (const file of sourceFiles) {
        if (!existsSync(file)) continue;
        const text = readFileSync(file, "utf-8");
        const lines = text.split("\n");
        let section = null;
        let sectionBody = "";
        const flush = () => {
          if (!section) return;
          const sentence = sectionBody
            .split(/(?<=[。！?！？.!?])\s*/)
            .map((part) => part.trim())
            .find((part) => part.length >= 12 && part.length <= 300);
          if (sentence) {
            const slug = section
              .toLowerCase()
              .replace(/[^a-z0-9\u4e00-\u9fff]+/g, "-")
              .replace(/^-+|-+$/g, "")
              .slice(0, 40);
            candidates.push({
              content: sentence.trim(),
              fact_key: slug ? `${process.cwd().split("/").pop().toLowerCase()}.${slug}` : undefined,
              tags: [section.toLowerCase()],
              file,
            });
          }
          section = null;
          sectionBody = "";
        };
        for (const line of lines) {
          const heading = line.match(/^#{2,3}\s+(.{1,60})\s*$/);
          if (heading) {
            flush();
            section = heading[1].trim();
            continue;
          }
          if (section && line.trim() && !line.startsWith("#")) {
            sectionBody += ` ${line.trim()}`;
          }
        }
        flush();
        if (candidates.length >= 5) break;
      }

      const picked = candidates.slice(0, 5);
      if (picked.length === 0) {
        console.log("未在 README.md / AGENTS.md / CLAUDE.md 中找到可提炼的小节。");
        return;
      }

      let seeded = 0;
      for (const candidate of picked) {
        const result = await callMcp("memory_remember", {
          content: candidate.content,
          fact_key: candidate.fact_key,
          tags: candidate.tags,
          type: "semantic",
          kind: "fact",
          scope_type: "project",
          scope_key: projectKey,
          verification: "observed",
          source_agent: agent,
          idempotency_key: `seed:${candidate.file}:${candidate.content.length}:${candidate.content.slice(0, 40)}`,
        }, command);
        if (result?.memory || result?.duplicate) seeded += 1;
      }
      console.log(`\n🌱 冷启动:已把 ${seeded} 条便签直接生效为 👀 观察（来自你仓库自己的文档）。不对的到「记忆」页当场删除即可。\n`);
      break;
    }

    default:
      console.error(`未知命令: ${command}`);
      printHelp();
      process.exit(1);
  }
}

function printHelp() {
  console.log(`
FlareMo Memory Ledger CLI

用法:
  flaremo setup               # 自检：URL / PAT / 连通 / 鉴权 / Skill 落位
  flaremo recall "查询词" [--as-of YYYY-MM-DD] [--from-scope <scope>]
  flaremo remember "记忆正文" [--key <fact_key>] [--tags <tag1,tag2>]
  flaremo checkpoint "本次战报摘要" [--item "原子结论"]
  flaremo lens [--scope <project>]
  flaremo status
  flaremo seed                # 冷启动：扫描 README/AGENTS 提炼候选便签（直接 👀 生效）

选项:
  --project, --scope  当前项目标识 (默认工作目录)
  --agent             调用 Agent 名称 (默认 'cli')
  --as-of             时态穿梭：查询历史某天成立的事实
  --from-scope        显式跨项目翻阅
  --key               指定确定性事实键 (fact_key)
  --tags              话题标签列表 (以逗号分隔)

退出码:
  0: 成功
  1: 参数错误
  3: 记忆服务不可达 (降级使用离线快照)
`);
}

main().catch((err) => {
  console.error("Fatal error:", err);
  process.exit(1);
});
