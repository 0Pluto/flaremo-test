{
  "specVersion": 1,
  "root": {
    "type": "column",
    "style": {
      "height": "100%",
      "background": { "light": "#ffffff", "dark": "#171717" },
      "borderWidth": 1,
      "borderColor": { "light": "#d4d4d4", "dark": "#404040" },
      "borderRadius": 8,
      "overflow": "hidden",
      "color": { "light": "#262626", "dark": "#f5f5f5" }
    },
    "children": [
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "space-between",
          "align": "center",
          "paddingX": 28,
          "paddingY": 16,
          "borderBottomWidth": 1,
          "borderStyle": "solid",
          "borderColor": { "light": "#e5e5e5", "dark": "#262626" }
        },
        "children": [
          {
            "type": "text",
            "text": "{date}",
            "style": {
              "font": { "size": 14, "color": { "light": "#737373", "dark": "#a3a3a3" } }
            }
          },
          {
            "type": "text",
            "text": "{brand.product}",
            "style": {
              "font": {
                "family": "heading",
                "size": 12,
                "weight": 600,
                "color": { "light": "#a3a3a3", "dark": "#737373" }
              }
            }
          }
        ]
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "height": 0,
          "align": "center",
          "justify": "space-between",
          "borderTopWidth": 1,
          "borderStyle": "dashed",
          "borderColor": { "light": "#d4d4d4", "dark": "#404040" }
        },
        "children": [
          {
            "type": "column",
            "style": {
              "width": 16,
              "height": 16,
              "borderRadius": 9999,
              "background": { "light": "#ffffff", "dark": "#171717" },
              "marginLeft": -8,
              "marginTop": -8
            }
          },
          {
            "type": "column",
            "style": {
              "width": 16,
              "height": 16,
              "borderRadius": 9999,
              "background": { "light": "#ffffff", "dark": "#171717" },
              "marginRight": -8,
              "marginTop": -8
            }
          }
        ]
      },
      {
        "type": "text",
        "text": "{body}",
        "style": {
          "flex": 1,
          "padding": 28,
          "clamp": 8,
          "overflow": "hidden",
          "font": { "size": 15, "lineHeight": 1.867 }
        }
      },
      {
        "type": "row",
        "style": {
          "width": "100%",
          "justify": "space-between",
          "align": "end",
          "paddingX": 28,
          "paddingBottom": 20
        },
        "children": [
          {
            "type": "text",
            "text": "{stats}",
            "style": {
              "font": { "size": 12, "color": { "light": "#a3a3a3", "dark": "#737373" } }
            }
          },
          {
            "type": "spacer",
            "style": {
              "width": 96,
              "height": 24,
              "opacity": 0.35,
              "color": { "light": "#404040", "dark": "#d4d4d4" },
              "backgroundCSS": "repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px)"
            }
          }
        ]
      }
    ]
  }
}
