{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaremo-test",
  "main": "./apps/worker/src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/article/*",
      "/feed.xml",
      "/file/*",
      "/mcp",
      "/memory/*",
      "/openapi.json",
      "/memos.api.v1.*",
      "/share/*",
      "/sitemap.xml",
      "/sitemap-articles.xml",
      "/favicon.ico"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flaremo-test",
      "database_id": "e6999d6f-c185-4c4d-bce2-18631d1ccdb8",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "flaremo-attachments-test","preview_bucket_name-test": "flaremo-attachments-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEMBER_REMOVAL_QUEUE",
        "queue": "flaremo-member-removal-test"
      },
      {
        "binding": "DATA_EXPORT_QUEUE",
        "queue": "flaremo-data-export-test"
      }
    ],
    "consumers": [
      {
        "queue": "flaremo-member-removal-test",
        "max_batch_size": 10,
        "max_retries": 5
      },
      {
        "queue": "flaremo-data-export-test",
        "max_batch_size": 5,
        "max_retries": 5
      }
    ]
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_MEMOS",
      "index_name": "flaremo-memos-test"
    },
    {
      "binding": "VECTORIZE_MEMORIES",
      "index_name": "flaremo-memories-test"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "FLAREMO_DEPLOY_REPOSITORY": "0Pluto/flaremo-test",
    "FLAREMO_SINGLE_USER_EMAIL": "ly.workmail@qq.com",
    "FLAREMO_SINGLE_USER_NAME": "lazy",
    "FLAREMO_PUBLIC_URL": "https://flaremoo.kuomo.site/",
    "FLAREMO_TRUSTED_ORIGINS": "https://flaremoo.kuomo.site/",
    "FLAREMO_EMBEDDING_PROVIDER": "workers-ai",
    "FLAREMO_EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
    "FLAREMO_EMBEDDING_DIMENSIONS": "1024",
    "FLAREMO_VECTORIZE_STORED_LIMIT": "5000000",
    "FLAREMO_VECTORIZE_QUERIED_LIMIT": "30000000"
  }
}
